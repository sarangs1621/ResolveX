{
  "functions": {
    "main.py": {
      "includeFiles": [
        "services/**",
        "kb/**",
        "static/**"
      ]
    },
    "api/index.py": {
      "includeFiles": [
        "main.py",
        "services/**",
        "kb/**",
        "static/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ]
}
